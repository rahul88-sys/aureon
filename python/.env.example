JWT_SECRET=aureon-dev-secret-change-in-production

# Vercel Blob (server-only — never expose to the browser)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# auto | pymupdf_text | tesseract | paddle
ENGINE_DEFAULT=auto
OCR_ENGINE=tesseract
ENABLE_HEAVY_OCR=0

# Comma-separated origins allowed to call this service directly (Nest is preferred)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
